/*
 * creature_pick_move, the map handler 23 FDAT overlays share (WIP; shared
 * fragment).
 * Each of those overlays' map unit includes it at its place in the run; the
 * claim is FDAT_002.BIN's address and the other overlays bind by name. Its
 * switch table is the last entry of the overlay's read-only run, so the
 * including unit's RODATA() claim covers it.
 */

/*
 * After the entry's move and script pick, sets the heading it turns to and
 * its second heading (unk5C, unk5A) from its state, then bends both by the
 * offset of its visible record.
 * The first heading uses a -1024 phase; the second passes unk5A directly.
 */
ADDRESS(0x801ed4a0, 0x244)
void creature_pick_move(void)
{
    Creature *e = vis_table_a.current;
    u16 wall;
    int d;
    short x;
    short z;
    short dx;
    short dz;

    if (e->script_state == 0xf0 || e->script_state == 0)
        return;
    creature_choose_action();
    creature_pick_weighted_script();
    switch (e->action) {
    case CREATURE_ACTION_TURN_AWAY:
        wall = e->wall_heading;
        if ((short)wall == 0x7fff) {
            e->unk5A = e->target_heading = (e->player_heading + 2048) & 0xfff;
        } else {
            d = (((e->player_heading + 2048) & 0xfff) - wall + 1024) & 0xfff;
            if (d < 1024 || d > 3072)
                e->unk5A = e->target_heading = (wall + 3072) & 0xfff;
            else
                e->unk5A = e->target_heading = (wall + 1024) & 0xfff;
        }
        break;
    case 2:
    case 4:
    case 16:
    case 32:
        e->unk5A = e->target_heading = e->player_heading;
        break;
    default:
        e->unk5A = e->target_heading = e->facing;
        break;
    }
    if (e->action != CREATURE_ACTION_TURN_AWAY)
        e->wall_heading = 0x7fff;
    if (vis_records[e->block].heading_bias_x != 0 || vis_records[e->block].heading_bias_z != 0) {
        x = rcos(e->target_heading - 1024) >> 5;
        z = rsin(e->target_heading - 1024) >> 5;
        dx = x + vis_records[e->block].heading_bias_x;
        dz = z + vis_records[e->block].heading_bias_z;
        e->target_heading = (ratan2(dz, dx) + 1024) & 0xfff;
        x = rcos(e->unk5A) >> 5;
        z = rsin(e->unk5A) >> 5;
        dx = x + vis_records[e->block].heading_bias_x;
        dz = z + vis_records[e->block].heading_bias_z;
        e->unk5A = ratan2(dz, dx);
    }
}
